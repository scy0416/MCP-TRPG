HOST=127.0.0.1
PORT=8000

# Local defaults are printed by `supabase start`. Replace them with hosted
# project values only in an untracked .env file.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=

# Derived from SUPABASE_URL when omitted. Set explicit hosted values only when
# an auth proxy or custom domain changes them.
SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# This exact URI is both the OAuth resource identifier and the JWT audience.
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
